    "limitations": [
      "Manual memoization with memo() and useMemo() and manual hoisting of static JSX are unnecessary when React Compiler is enabled.",
      "toSorted() needs Chrome 110+, Safari 16+, Firefox 115+ or Node.js 20+, and older environments need a spread copy before sort().",
      "Math.min and Math.max with spread can be slower or throw for very large arrays.",
      "useEffectEvent is available only on the latest React.",
      "In traditional serverless each invocation runs in isolation, so an in-process LRU cache does not persist across requests.",
      "Suspense boundaries are not for critical layout data, SEO-critical content above the fold or small, fast queries."
    ],
    "known_problems": [
      {
        "problem": "lucide-react deep import paths resolve to an implicit any type under strict or noImplicitAny",
        "workaround": "prefer optimizePackageImports, or verify the library exports types for its subpaths"
      },
      {
        "problem": "localStorage getItem() and setItem() throw in private browsing, when quota is exceeded or when disabled",
        "workaround": "wrap every call in try-catch"
      },
      {
        "problem": "requestIdleCallback is missing in unsupported browsers",
        "workaround": "fall back to setTimeout"
      },
      {
        "problem": "a global regex keeps mutable lastIndex state between calls",
        "workaround": "not stated beyond the warning"
      }
    ],
