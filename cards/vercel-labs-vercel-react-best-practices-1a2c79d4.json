  "version": "vercel-labs/agent-skills at 1a2c79d4",
  "what_it_does": {
    "name": "vercel-react-best-practices",
    "summary": "A performance optimization guide for React and Next.js applications, maintained by Vercel, with 70 rules across 8 categories prioritized by impact, from eliminating waterfalls and bundle size down to advanced patterns. Each rule is a Markdown file with a brief explanation, an incorrect and a correct code example and references, and AGENTS.md compiles all rules into one document. The rules guide automated refactoring and code generation. Use it when writing new React components or Next.js pages, implementing data fetching, reviewing code for performance issues, refactoring React or Next.js code, or optimizing bundle size or load times.",
    "tasks": [
      "eliminate async waterfalls with Promise.all, deferred awaits and Suspense boundaries",
      "reduce bundle size with direct imports, next/dynamic and deferred third-party libraries",
      "speed up server rendering with React.cache, LRU caching, parallel fetching and minimal serialization",
      "authenticate Server Actions inside each action",
      "cut re-renders with memoization, derived state, transitions and refs",
      "improve rendering and JavaScript hot paths such as hydration, SVG, loops and lookups"
    ],
    "outputs": [
      {
        "what": "new or refactored React and Next.js code that follows the rules",
        "kind": "information",
        "form": "TypeScript, TSX, CSS and config source files",
        "destination": "the user's project"
      },
      {
        "what": "performance issues found in a code review, with the rule that applies",
        "kind": "recommendation",
        "form": "text in the agent's reply",
        "destination": "the conversation with the user"
      },
      {
        "what": "SVG files with reduced coordinate precision",
        "kind": "information",
        "form": "SVG file",
        "destination": "the SVG file passed to svgo, such as icon.svg"
      }
    ],
    "sample_output": "const userById = new Map(users.map(u => [u.id, u]))",
    "inputs": [
      {
        "what": "existing React or Next.js code",
        "type": "source files in the user's project",
        "required": "conditional",
        "for": "reviewing or refactoring code",
        "example": "not declared"
      },
      {
        "what": "whether the project uses Next.js 13.5 or later, React Compiler or the latest React",
        "type": "facts about the project setup",
        "required": "conditional",
        "for": "choosing between rule variants such as optimizePackageImports, manual memoization or useEffectEvent",
        "example": "not declared"
      }
    ],
