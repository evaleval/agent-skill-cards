        "source": "model",
        "severity": "none",
        "mitigation": "none stated",
        "taxonomy": "not examined"
      }
    ],
    "limitations": [
      "UUIDv7 primary keys require the pg_uuidv7 extension.",
      "Named prepared statements fail in transaction-mode pooling, and session mode is needed for prepared statements and temp tables.",
      "No dependency carries a version."
    ],
    "known_problems": [
      {
        "problem": "ERROR: prepared statement \"get_user\" does not exist under transaction-mode pooling",
        "workaround": "use unnamed prepared statements, deallocate after use, or use session mode pooling"
      },
      {
        "problem": "ADD CONSTRAINT IF NOT EXISTS causes a syntax error in migrations",
        "workaround": "use a DO block that checks pg_constraint before adding the constraint"
      },
      {
        "problem": "ERROR: relation \"users\" does not exist with quoted mixed-case identifiers",
        "workaround": "use lowercase snake_case, or create views as a compatibility layer"
      },
      {
        "problem": "deadlocks when transactions lock rows in different orders",
        "workaround": "lock rows in a consistent order first, or update in a single statement"
      },
      {
        "problem": "duplicate key error from check-then-insert",
        "workaround": "use insert ... on conflict"
      }
    ],
    "evaluations": "none"
  },
