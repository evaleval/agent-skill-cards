{
  "schema": "Skill Card v1.2",
  "skill": "supabase-postgres-best-practices",
  "version": "supabase/agent-skills at c9be0e93",
  "what_it_does": {
    "name": "supabase-postgres-best-practices",
    "summary": "A Postgres performance and design guide maintained by Supabase, made of one instruction file and 31 rule files in eight categories ranked by impact, from query performance and connection management to advanced features. Each rule explains why it matters and shows incorrect and correct SQL, with EXPLAIN output or metrics where useful and Supabase notes where they apply. The agent reads the rule files that fit the task and writes or reviews SQL, schemas, indexes, RLS policies and connection settings by them. Use it when writing SQL or designing schemas, optimizing queries, reviewing database performance, configuring connection pooling or working with Row-Level Security.",
    "tasks": [
      "add and choose indexes for WHERE, JOIN, JSONB and full-text queries",
      "configure connection pooling, limits and idle timeouts",
      "enable and optimize Row-Level Security and least privilege grants",
      "choose data types, primary keys, partitioning and safe migration constraints",
      "reduce lock contention, deadlocks and N+1 queries",
      "diagnose slow queries with EXPLAIN ANALYZE, pg_stat_statements and VACUUM statistics",
      "for Postgres running anywhere, with Supabase-specific notes"
    ],
    "author_description": "Postgres best practices maintained by Supabase, for Postgres running anywhere. Load this skill BEFORE writing or changing anything that lives in a Postgres database: creating or altering tables and columns (including choosing column types), schema design, migrations and declarative schema files, RLS policies and the tests that verify them, indexes, triggers, database functions, queues and scheduled jobs (pg_cron, pgmq), vector/semantic search (pgvector), and restoring dumps (pg_restore) or importing data. Also load it when diagnosing slow queries, high CPU, timeouts, EXPLAIN plans, connection exhaustion, locking, bloat, or rows visible to the wrong user or tenant. This is not just a performance guide — schema, migration, security, and SQL authoring tasks need these rules too, even for a one-column change or a single query.",
    "outputs": [
      {
        "what": "SQL for tables, indexes, constraints, RLS policies, roles and queries written by the rules",
        "kind": "information",
        "form": "SQL text",
        "destination": "the agent's answer or the migration and query files the agent writes"
      },
      {
        "what": "advice on which indexes, pool settings, data types and query rewrites to apply",
        "kind": "recommendation",
        "form": "text with incorrect and correct SQL",
        "destination": "the agent's answer to the user"
      },
      {
        "what": "changes to a database when the SQL is run, such as new indexes, policies, roles and server settings",
        "kind": "action",
        "form": "database objects and settings",
        "destination": "the Postgres database"
      },
      {
        "what": "diagnostic results from EXPLAIN ANALYZE, pg_stat_statements and pg_stat_activity",
        "kind": "information",
        "form": "query plans and result rows",
        "destination": "the agent's context"
      }
    ],
    "sample_output": "Index Scan using orders_customer_id_idx (cost=0.42..8.44 rows=100 width=85)",
    "inputs": [
      {
        "what": "a SQL query or schema to write or review",
        "type": "SQL text",
        "required": "required",
        "for": "every task",
        "example": "select * from orders where customer_id = 123;"
      },
      {
        "what": "a slow query to diagnose",
        "type": "SQL text run under EXPLAIN",
        "required": "conditional",
        "for": "diagnosing slow queries",
        "example": "explain (analyze, buffers, format text) select * from orders where customer_id = 123 and status = 'pending';"
      },
      {
        "what": "the available RAM and CPU cores of the database server",
        "type": "numbers",
        "required": "conditional",
        "for": "setting connection limits and pool size",
        "example": "Example for 4 cores: pool_size = 10"
      }
    ],
